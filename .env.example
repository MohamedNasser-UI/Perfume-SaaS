# API
DATABASE_URL=postgresql://perfume:perfume@localhost:5432/perfume?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_COOKIE_SECURE=
PORT=3001
WEB_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# Email: console | smtp | resend
# console logs the reset URL in the API terminal (no inbox).
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Seed
PLATFORM_ADMIN_EMAIL=admin@perfume.saas
PLATFORM_ADMIN_PASSWORD=ChangeMe123!
DEMO_OWNER_EMAIL=owner@noor.perfume
DEMO_OWNER_PASSWORD=ChangeMe123!

# Web — keep this relative so the refresh cookie stays first-party (Vite proxies /api)
VITE_API_URL=/api/v1

# Device license (ECDSA P-256 PEM). Generate with: node scripts/generate-license-keys.mjs
# Private key never ships to the browser.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
VITE_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
OFFLINE_LICENSE_DURATION_HOURS=168
